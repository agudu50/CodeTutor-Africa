# CodeTutor Africa - Environment Configuration
# Target: 8 GB RAM, Core i5 / Ryzen 5, Integrated Graphics, Ubuntu 22.04 LTS

APP_ENV=development
APP_NAME=CodeTutor Africa Backend
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Local Database
DATABASE_URL=sqlite+aiosqlite:///./data/database/codetutor.db

# LLM & GGUF Model Settings (Optimized for 8GB RAM / CPU-only inference)
MODEL_PROVIDER=mock
MODEL_PATH=./models/qwen2.5-coder-3b-instruct-q4_k_m.gguf
MODEL_CONTEXT_SIZE=2048
MODEL_THREADS=4
MODEL_BATCH_SIZE=256
MODEL_GPU_LAYERS=0
MODEL_USE_MMAP=true
MODEL_USE_MLOCK=false

# Concurrency & Memory Budget
MAX_CONCURRENT_INFERENCES=1
PEAK_MEMORY_BUDGET_GB=7.0

# CORS (Local development)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
